# Clinly production environment template
# Copy to a secure host-only location or inject these values from your
# deployment platform / secrets manager. Never commit real production secrets.

LOG_LEVEL=INFO
API_TITLE=Clinly Backbone
API_VERSION=1.0.0

# Public product identity compiled into the web image.
APP_DISPLAY_NAME=Clinly
APP_TAGLINE=One relationship. One connected place.
CLINLY_HTTP_PORT=8080

# Use an authenticated, TLS-protected production MongoDB connection.
MONGO_URI=mongodb+srv://APP_USER:APP_PASSWORD@YOUR_PRIVATE_CLUSTER/clinly
MONGO_DB_NAME=clinly
MONGO_CONNECT_TIMEOUT_MS=3000
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000

# Generate unique values. Do not reuse development values.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TOKEN_MINUTES=60
MESSAGE_ENCRYPTION_KEY=REPLACE_WITH_A_URLSAFE_BASE64_32_BYTE_KEY

# JSON array of the exact public HTTPS web origins allowed to call the API.
CORS_ALLOWED_ORIGINS=["https://app.example.com"]

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
