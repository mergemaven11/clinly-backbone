# Clinly Backbone local development configuration
# Copy this file to .env before running Docker Compose.

APP_ENV=dev
LOG_LEVEL=INFO
API_TITLE=Clinly Backbone
API_VERSION=0.1.0

# Local-only Mongo credentials used by docker-compose.yml.
# Replace these values outside local development.
MONGO_ROOT_USER=clinly_dev
MONGO_ROOT_PASS=clinly_dev_password
MONGO_DB_NAME=clinly_backbone
MONGO_URI=mongodb://clinly_dev:clinly_dev_password@mongo:27017/clinly_backbone?authSource=admin
MONGO_CONNECT_TIMEOUT_MS=3000
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000

# Development-only secrets. Generate unique production values and store them
# in a secrets manager; never reuse these example values outside local dev.
JWT_SECRET=dev-only-jwt-secret-change-before-production-123456
JWT_ACCESS_TOKEN_MINUTES=60
MESSAGE_ENCRYPTION_KEY=fFauOTt3BH8g9ZW7qzMjYBlq4WqrbGzZkr0KQINCO3c=

# CORS is disabled when this list is empty. Use a JSON array of exact origins.
CORS_ALLOWED_ORIGINS=[]

# Application-level login brute-force backstop.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
